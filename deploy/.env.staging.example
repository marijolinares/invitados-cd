# Copia este archivo a deploy/.env.staging (no se sube a Git)
COMPOSE_PROJECT_NAME=invitados-staging
IMAGE=invitados-cd:local
APP_ENV=staging
HOST_PORT=8081
PROM_PORT=9091
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-staging
SESSION_MINUTES=60
IMAGE_MAX_BYTES=2097152
CPU_LIMIT=0.50
MEM_LIMIT=256M
LOG_LEVEL=debug
PROM_RETENCION=3d
