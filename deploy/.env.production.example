# Copia este archivo a deploy/.env.production (no se sube a Git)
COMPOSE_PROJECT_NAME=invitados-prod
IMAGE=ghcr.io/marijolinares/invitados-cd:latest
APP_ENV=production
HOST_PORT=8080
PROM_PORT=9090
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-produccion
SESSION_MINUTES=30
IMAGE_MAX_BYTES=2097152
CPU_LIMIT=1.00
MEM_LIMIT=256M
LOG_LEVEL=info
PROM_RETENCION=15d
