{
  "name": "invitados-cd",
  "version": "1.0.0",
  "description": "Caso de estudio: sistema de registro de invitados a eventos con liberación y despliegue continuo",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
